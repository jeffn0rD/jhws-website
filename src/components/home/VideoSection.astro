---
// YouTube Video Section - Between Section 2 and 3
---

<section class="bg-gradient-primary-to-secondary py-5">
  <div class="container px-5">
    <div class="row gx-5 justify-content-center">
      <div class="col-lg-10">
        <div class="text-center mb-4">
          <h2 class="display-5 lh-1 mb-3 text-white">Watch Our Story</h2>
          <p class="lead text-white-50 mb-4">Learn more about the Joshua House Warming Shelter and our mission</p>
        </div>
        
        <!-- Responsive YouTube Video Container -->
        <div class="ratio ratio-16x9 shadow-lg rounded">
          <iframe 
            id="ytplayer" 
            type="text/html"
            src="https://www.youtube.com/embed/P2aaFJucszs?enablejsapi=1"
            title="Joshua House Warming Shelter Video"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            class="rounded">
          </iframe>
        </div>
      </div>
    </div>
  </div>
</section>