---
// Benefit Talent Show Section
---

<section class="bg-gradient-primary-to-secondary" id="benefit">
  <div class="container px-5">
    <div class="row gx-5 justify-content-center">
      <div class="col-lg-10">
        <div class="text-center mb-5">
          <h2 class="display-5 lh-1 mb-3 text-white">Kelly Stuber Presents:</h2>
          <h2 class="display-4 lh-1 mb-4 text-white">The Joshua House Warming Shelter</h2>
          <h3 class="display-6 lh-1 mb-3 text-white">Benefit Talent Show!</h3>
          <p class="lead text-white-50 mb-4">Hosted by Elia Spates</p>
        </div>

        <!-- Event Details Card -->
        <div class="card border-0 shadow-lg mb-4">
          <div class="card-body p-5">
            <div class="text-center mb-4">
              <i class="bi-calendar-event icon-feature text-gradient d-block mb-3" style="font-size: 3rem;"></i>
              <h4 class="font-alt mb-3">Tuesday, December 9th</h4>
              <h5 class="mb-3">6:00 PM - 9:00 PM</h5>
              <p class="text-muted mb-3">
                <strong>Location:</strong> Eastside Restaurant
              </p>
            </div>
            <p class="text-muted mb-3">
              Performers include: Tod Pronto, Nate Graves, Shane Goodwin, Aaron Fuller, Chris Doncaster, Kelly Stuber, Samantha Simcoe, Kelby Rodriguez & Steve McManus.
            </p>
            <p class="text-muted mb-4">
              <strong>Tickets:</strong> $45 ($50 at the door) and include the Eastside Appetizer Buffet!
            </p>
            
            <div class="text-center mb-4">
              <h5 class="font-alt mb-3">Purchase tickets online at www.jhwsnewport.org</h5>
              <p class="text-muted mb-3">
                Select "Purchase Tickets via Donorbox" and in the "Custom Amount" type in $45 for 1, or $90 for 2, or whatever multiple of $45 you would like.
              </p>
              <a href="https://donorbox.org/joshua-house-warming-shelter?" class="dbox-donation-button btn btn-primary btn-lg rounded-pill px-4 mb-3">
                <i class="bi-ticket-perforated me-2"></i>
                Purchase Tickets via Donorbox
              </a>
              <p class="text-muted small mb-0">
                <em>Bring your receipt with you to the Benefit on Dec. 9th.</em>
              </p>
            </div>
            
            <div class="alert alert-info mt-4" role="alert">
              <i class="bi-info-circle me-2"></i>
              <strong>Please note:</strong> The donation figure toward the $50K goal does not accurately reflect the money raised to date. It is significantly more.
            </div>
          </div>
        </div>

        <!-- Quilt Raffle Card -->
        <div class="card border-0 shadow-lg">
          <div class="card-body p-5">
            <div class="row gx-5 align-items-center">
              <div class="col-lg-6 mb-4 mb-lg-0">
                <img src="/images/quilt-elia-spates.jpg" alt="Lap Quilt created by Elia Spates" class="img-fluid rounded shadow">
              </div>
              <div class="col-lg-6">
                <div class="text-center text-lg-start">
                  <i class="bi-gift icon-feature text-gradient d-block mb-3" style="font-size: 3rem;"></i>
                  <h4 class="font-alt mb-3">Lap Quilt Raffle</h4>
                  <p class="text-muted mb-3">
                    <strong>Sewn with Love & Cusses!</strong>
                  </p>
                  <p class="text-muted mb-3">
                    As the MC/Host of the Benefit Talent Show, Elia has created a Lap Quilt that is being raffled off.
                  </p>
                  <p class="text-muted mb-3">
                    <strong>Raffle Tickets:</strong> $10 each or 3 for $25
                  </p>
                  <p class="text-muted mb-0">
                    Tickets can be purchased from:
                  </p>
                  <ul class="text-muted mb-0">
                    <li>Elia Spates at Memphremagog Rentals</li>
                    <li>Erica Gray at the Brown Cow</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>