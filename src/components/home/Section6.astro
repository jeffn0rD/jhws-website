---
// Benefit Talent Show Section
---



<section class="bg-gradient-primary-to-secondary" id="benefit">
  <div class="container px-5">
    <div class="row gx-5 justify-content-center">
      <div class="col-lg-10">
		<div class="text-center mb-5"> 
			<h1 class="display-5 fw-bold mb-3 text-danger" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.3);">Kelly Stuber Presents:</h1> 
			<h1 class="display-3 fw-bold mb-3 text-white" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.3);">The Joshua House Warming Shelter</h1> 
			<h1 class="display-3 fw-bold mb-4 text-white" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.3);">Benefit Talent Show!</h1> 
			<h2 class="display-5 fw-bold text-danger mb-5" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.3);">Hosted by Elia Spates</h2> 
		</div>

        <!-- Event Details Card -->
        <div class="card border-0 shadow-lg mb-4">
          <div class="card-body p-5">
            <div class="text-center mb-4">
              <h3 class="display-6 fw-bold mb-3" style="color: #2c3e50;">Tuesday, December 9<sup>th</sup></h3>
              <h2 class="display-5 fw-bold mb-3" style="color: #2c3e50;">6:00 to 9:00</h2>
              <h3 class="display-6 fw-bold mb-4" style="color: #2c3e50;">at the Eastside Restaurant</h3>
            </div>
            
			  <div class="text-center mb-5"> 
				<h4 class="fw-bold mb-3" style="font-size: 1.5rem; color: #2c3e50;">Performances by:</h4>	
				<p class="fs-5 mb-3" style="color: #3498db; line-height: 1.6;">
				  Tod Pronto, Nate Graves, Shane Goodwin, Aaron Fuller, Chris Doncaster, Kelly Stuber, Samantha Simcoe, Kelby Rodriguez & Steve McManus.
				</p>
			  </div>
            
            <div class="text-center mb-4 p-4" style="background-color: #f8f9fa; border-radius: 10px;">
              <p class="fs-4 fw-bold mb-2" style="color: #2c3e50;">
                <span style="text-decoration: underline;">Tickets are $45 ($50 at the door)</span>
              </p>
              <p class="fs-5 mb-0" style="color: #2c3e50;">
                and include the Eastside Appetizer Buffet!
              </p>
            </div>
            
            <div class="text-center mb-4">
              <h5 class="fw-bold mb-3" style="font-size: 1.4rem; color: #2c3e50;">Purchase tickets online at www.jhwsnewport.org</h5>
              <p class="fs-6 mb-3" style="color: #495057;">
                Select <strong>"Purchase Tickets via Donorbox"</strong> and in the <strong>"Custom Amount"</strong> <span style="text-decoration: underline;">type in $45 for 1</span>, or <span style="text-decoration: underline;">$90 for 2</span>, <span style="text-decoration: underline;">or whatever multiple of $45</span> you would like.
              </p>
              <a href="https://donorbox.org/joshua-house-warming-shelter?" class="dbox-donation-button btn btn-primary btn-lg rounded-pill px-5 py-3 mb-3" style="font-size: 1.2rem; font-weight: bold;">
                <i class="bi-ticket-perforated me-2"></i>
                Purchase Tickets via Donorbox
              </a>
              <p class="fs-6 mb-0" style="color: #495057;">
                <strong>Bring your receipt with you to the Benefit on Dec. 9<sup>th</sup>.</strong>
              </p>
            </div>
            
            <div class="alert alert-warning mt-4 text-center" role="alert" style="border-left: 5px solid #ffc107;">
              <p class="mb-0" style="font-size: 0.85rem; line-height: 1.4;">
                <strong>(Please note:</strong> The donation figure toward the $50K goal does not accurately reflect the money raised to date. It is significantly more<strong>)</strong>
              </p>
            </div>
          </div>
        </div>

        <!-- Quilt Raffle Card -->
        <div class="card border-0 shadow-lg">
          <div class="card-body p-5">
            <div class="row gx-5 align-items-center">
              <div class="col-lg-6 mb-4 mb-lg-0">
                <img src="/images/quilt-elia-spates.jpg" alt="Lap Quilt created by Elia Spates" class="img-fluid rounded shadow">
              </div>
              <div class="col-lg-6">
                <div class="text-center text-lg-start">
                  <i class="bi-gift icon-feature text-gradient d-block mb-3" style="font-size: 3rem;"></i>
                  <h4 class="font-alt mb-3">Lap Quilt Raffle</h4>
                  <p class="text-muted mb-3">
                    <strong>Sewn with Love & Cusses!</strong>
                  </p>
                  <p class="text-muted mb-3">
                    As the MC/Host of the Benefit Talent Show, Elia has created a Lap Quilt that is being raffled off.
                  </p>
                  <p class="text-muted mb-3">
                    <strong>Raffle Tickets:</strong> $10 each or 3 for $25
                  </p>
                  <p class="text-muted mb-0">
                    Tickets can be purchased from:
                  </p>
                  <ul class="text-muted mb-0">
                    <li>Elia Spates at Memphremagog Rentals</li>
                    <li>Erica Gray at the Brown Cow</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>