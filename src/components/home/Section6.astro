---
// Benefit Talent Show Section
---

<section class="bg-gradient-primary-to-secondary" id="benefit">
  <div class="container px-5">
    <div class="row gx-5 justify-content-center">
      <div class="col-lg-10">
        <!-- Quilt Raffle Card -->
        <div class="card border-0 shadow-lg">
          <div class="card-body p-5">
            <div class="row gx-5 align-items-center">
              <div class="col-lg-6 mb-4 mb-lg-0">
                <img src="/images/quilt-elia-spates.jpg" alt="Lap Quilt created by Elia Spates" class="img-fluid rounded shadow">
              </div>
              <div class="col-lg-6">
                <div class="text-center text-lg-start">
                  <i class="bi-gift icon-feature text-gradient d-block mb-3" style="font-size: 3rem;"></i>
                  <h4 class="font-alt mb-3">Lap Quilt Raffle</h4>
                  <p class="text-muted mb-3">
                    <strong>Sewn with Love & Cusses!</strong>
                  </p>
                  <p class="text-muted mb-3">
                    As the MC/Host of the Benefit Talent Show, Elia has created a Lap Quilt that is being raffled off.
                  </p>
                  <p class="text-muted mb-3">
                    <strong>Raffle Tickets:</strong> $10 each or 3 for $25
                  </p>
                  <p class="text-muted mb-0">
                    Tickets can be purchased from:
                  </p>
                  <ul class="text-muted mb-0">
                    <li>Elia Spates at Memphremagog Rentals</li>
                    <li>Erica Gray at the Brown Cow</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>