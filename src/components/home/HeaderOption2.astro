---
// Option 2: Background Image Hero with Overlay
import { Image } from 'astro:assets';
import imgReference from '../../images/JoshuaHouse.jpg';
---

<header class="hero-header position-relative" style="min-height: 70vh; display: flex; align-items: center;">
  <!-- Background Image -->
  <div class="position-absolute top-0 start-0 w-100 h-100" style="z-index: 1;">
    <Image 
      src={imgReference} 
      inferSize={true} 
      alt="Joshua House Warming Shelter Benefit" 
      class="w-100 h-100"
      style="object-fit: cover;"
    />
    <!-- Dark Overlay -->
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(to bottom, rgba(0,0,0,0.5), rgba(0,0,0,0.7));"></div>
  </div>
  
  <!-- Content -->
  <div class="container px-5 position-relative" style="z-index: 2;">
    <div class="row gx-5 justify-content-center">
      <div class="col-lg-10 text-center">
        <h1 class="display-1 lh-1 mb-3 text-white" style="text-shadow: 2px 2px 8px rgba(0,0,0,0.8);">
          Joshua House Warming Shelter
        </h1>
        <p class="lead fw-normal text-white mb-3" style="text-shadow: 1px 1px 4px rgba(0,0,0,0.8);">
          A part of Joshua House, Inc. A federally recognized 501c3 non-profit organization
        </p>
        <p class="lead fw-normal text-white mb-3" style="text-shadow: 1px 1px 4px rgba(0,0,0,0.8);">
          501 Pleasant St., Newport, VT
        </p>
        <p class="lead fw-bold text-white mb-4" style="text-shadow: 1px 1px 4px rgba(0,0,0,0.8); font-size: 1.5rem;">
          Opening soon!
        </p>
        
        <div class="d-flex flex-column align-items-center mb-5">
          <a class="btn btn-primary btn-lg rounded-pill px-5 py-3 shadow-lg" href="#donate" style="font-size: 1.2rem;">
            <i class="bi-heart-fill me-2"></i>
            Donate Now
          </a>
        </div>
        
        <!-- Ticket Purchase Info Card -->
        <div class="card border-0 shadow-lg mx-auto" style="max-width: 800px; background-color: rgba(255, 255, 255, 0.95);">
          <div class="card-body p-4 p-md-5">
            <h3 class="h4 fw-bold text-dark mb-4">
              <i class="bi-ticket-perforated text-primary me-2"></i>
              Purchase Tickets for the Benefit
            </h3>
            
            <div class="text-start mb-4">
              <p class="fw-bold text-dark mb-2">
                To purchase tickets here:
              </p>
              <p class="text-dark mb-3">
                Select <strong>"Donate"</strong> <em>(above)</em> and in the <em>"Custom Amount"</em> type in $45 for 1, or $90 for 2, or whatever multiple of $45 you would like.
              </p>
            </div>
            
            <div class="alert alert-warning mb-4" role="alert">
              <i class="bi-exclamation-triangle me-2"></i>
              <strong>Bring your receipt with you to the Benefit on Dec. 9th, this is your Ticket!</strong>
            </div>
            
            <div class="mb-4 p-3 bg-light rounded text-start">
              <p class="small fst-italic text-muted mb-0">
                <i class="bi-info-circle me-2"></i>
                The donation figure on the site does not accurately reflect the money raised to date, which is approximately $35,000.
              </p>
            </div>
            
            <div class="border-top pt-4 text-start">
              <p class="fw-bold text-dark mb-2">
                <i class="bi-shop me-2"></i>Tickets can also be purchased at:
              </p>
              <p class="h5 text-primary mb-1">The Witches Brew</p>
              <p class="text-muted mb-0">Main Street, Newport</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .hero-header {
    overflow: hidden;
  }
  
  @media (max-width: 768px) {
    .hero-header {
      min-height: auto;
      padding: 3rem 0;
    }
  }
</style>