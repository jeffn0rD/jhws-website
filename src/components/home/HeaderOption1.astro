---
// Option 1: Two-Column Layout with Expandable Image
import { Image } from 'astro:assets';
import imgReference from '../../images/JoshuaHouse.jpg';
---

<header class="masthead">
  <div class="container px-5">
    <div class="row gx-5 align-items-start">
      <!-- Left Column: Image -->
      <div class="col-lg-6 mb-5 mb-lg-0">
        <div class="text-center">
          <h1 class="display-1 lh-1 mb-3">Joshua House Warming Shelter</h1>
          <p class="lead fw-normal text-muted mb-3">A part of Joshua House, Inc. A federally recognized 501c3 non-profit organization</p>
          <p class="lead fw-normal text-muted mb-3">501 Pleasant St., Newport, VT</p>
          <p class="lead fw-normal text-muted mb-3"><b>Opening soon!</b></p>
          <div class="d-flex flex-column align-items-center mb-4">
            <a class="btn btn-primary btn-lg rounded-pill px-4" href="#donate">
              <i class="bi-heart-fill me-2"></i>
              Donate
            </a>
          </div>
        </div>
        
        <!-- Clickable Image -->
        <div class="position-relative" style="cursor: pointer;" id="imageContainer">
          <Image 
            src={imgReference} 
            inferSize={true} 
            alt="Joshua House Warming Shelter Benefit" 
            class="img-fluid rounded shadow"
            style="max-height: 600px; width: 100%; object-fit: cover;"
            id="headerImage"
          />
          <div class="position-absolute bottom-0 start-0 end-0 text-center pb-3">
            <span class="badge bg-dark bg-opacity-75 py-2 px-3">
              <i class="bi-zoom-in me-2"></i>Click to expand
            </span>
          </div>
        </div>
      </div>
      
      <!-- Right Column: Ticket Purchase Info -->
      <div class="col-lg-6">
        <div class="p-4 bg-white rounded shadow-lg" style="position: sticky; top: 20px;">
          <h3 class="h4 fw-bold text-dark mb-4">
            <i class="bi-ticket-perforated text-primary me-2"></i>
            Purchase Tickets for the Benefit
          </h3>
          
          <div class="mb-4">
            <p class="lead fw-bold text-dark mb-2">
              To purchase tickets here:
            </p>
            <p class="text-dark mb-3">
              Select <strong>"Donate"</strong> <em>(above)</em> and in the <em>"Custom Amount"</em> type in $45 for 1, or $90 for 2, or whatever multiple of $45 you would like.
            </p>
          </div>
          
          <div class="alert alert-warning mb-4" role="alert">
            <i class="bi-exclamation-triangle me-2"></i>
            <strong>Bring your receipt with you to the Benefit on Dec. 9th, this is your Ticket!</strong>
          </div>
          
          <div class="mb-4 p-3 bg-light rounded">
            <p class="small fst-italic text-muted mb-0">
              <i class="bi-info-circle me-2"></i>
              The donation figure on the site does not accurately reflect the money raised to date, which is approximately $35,000.
            </p>
          </div>
          
          <div class="border-top pt-4">
            <p class="fw-bold text-dark mb-2">
              <i class="bi-shop me-2"></i>Tickets can also be purchased at:
            </p>
            <p class="h5 text-primary mb-1">The Witches Brew</p>
            <p class="text-muted mb-0">Main Street, Newport</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Lightbox Modal -->
<div id="imageLightbox" class="position-fixed top-0 start-0 w-100 h-100 d-none" style="background-color: rgba(0,0,0,0.95); z-index: 9999; cursor: pointer;">
  <button id="closeLightbox" class="btn btn-light position-absolute top-0 end-0 m-4" style="z-index: 10000;">
    <i class="bi-x-lg"></i> Close
  </button>
  <div class="d-flex align-items-center justify-content-center h-100 p-4">
    <img id="lightboxImage" src="" alt="Joshua House Warming Shelter Benefit" class="img-fluid" style="max-height: 90vh; max-width: 90vw;">
  </div>
</div>

<script>
  // Lightbox functionality
  const imageContainer = document.getElementById('imageContainer');
  const headerImage = document.getElementById('headerImage');
  const lightbox = document.getElementById('imageLightbox');
  const lightboxImage = document.getElementById('lightboxImage');
  const closeLightbox = document.getElementById('closeLightbox');
  
  if (imageContainer && lightbox && lightboxImage) {
    // Open lightbox
    imageContainer.addEventListener('click', () => {
      lightboxImage.src = headerImage.src;
      lightbox.classList.remove('d-none');
      document.body.style.overflow = 'hidden';
    });
    
    // Close lightbox
    const closeLightboxFunc = () => {
      lightbox.classList.add('d-none');
      document.body.style.overflow = 'auto';
    };
    
    lightbox.addEventListener('click', closeLightboxFunc);
    closeLightbox.addEventListener('click', (e) => {
      e.stopPropagation();
      closeLightboxFunc();
    });
    
    // Prevent closing when clicking the image itself
    lightboxImage.addEventListener('click', (e) => {
      e.stopPropagation();
    });
    
    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox.classList.contains('d-none')) {
        closeLightboxFunc();
      }
    });
  }
</script>

<style>
  #imageContainer:hover .badge {
    background-color: rgba(0, 0, 0, 0.9) !important;
  }
  
  #imageLightbox {
    transition: opacity 0.3s ease;
  }
  
  @media (max-width: 991px) {
    #imageContainer {
      cursor: default;
    }
    #imageContainer .badge {
      display: none;
    }
  }
</style>